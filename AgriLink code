<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AgriLink AI</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f1f8e9;
    }

    header {
      background: #2e7d32;
      color: white;
      text-align: center;
      padding: 25px 15px;
    }

    .container {
      padding: 20px;
    }

    .card {
      background: white;
      padding: 20px;
      margin: 15px 0;
      border-radius: 15px;
      box-shadow: 0 3px 10px #ccc;
    }

    button {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 10px;
      background: #43a047;
      color: white;
      font-size: 16px;
    }
  </style>
</head>

<body>

<header>
  <h1>🌾 AgriLink AI</h1>
  <p>Farmer Market Linkage & Price Discovery</p>
</header>

<div class="container">

  <div class="card">
    <h2>👨‍🌾 Farmer</h2>
    <p>Sell your crops directly to buyers.</p>
    <button onclick="alert('Farmer Portal')">
      Farmer Portal
    </button>
  </div>

  <div class="card">
    <h2>🛒 Buyer</h2>
    <p>Find crops directly from farmers.</p>
    <button onclick="alert('Buyer Portal')">
      Buyer Portal
    </button>
  </div>

  <div class="card">
    <h2>📊 Market Prices</h2>
    <p>Check crop prices and find better markets.</p>
    <button onclick="alert('Market Prices')">
      View Prices
    </button>
  </div>

</div>

</body>
</html>
